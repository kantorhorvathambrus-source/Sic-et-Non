---
// Switches language without losing the reader's place: every link points at the
// same topic in the other language, and the current hash is carried across
// because argument ids are the same in all five files.
import { locales, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  // /** Where each locale's link goes. */
  alternates: Record<Locale, string>;
  // /** The locales that genuinely carry this page. Others land on a home page. */
  translated?: Partial<Record<Locale, string>>;
}

const { locale, alternates, translated } = Astro.props;
const t = useTranslations(locale);
// A language this page has not been written in yet still gets a link, because a
// missing one is worse, but it says where it is actually going rather than
// looking identical to the four that keep the reader's place.
const has = (code: Locale) => !translated || Boolean(translated[code]);
---

<nav class="lang" aria-label={t('lang.switch')}>
  <ul>
    {
      locales.map((code) => (
        <li>
          <a
            href={alternates[code]}
            hreflang={code}
            lang={code}
            data-lang-link
            class:list={{ untranslated: !has(code) }}
            aria-current={code === locale ? 'true' : undefined}
          >
            <abbr title={has(code) ? t(`lang.${code}`) : `${t(`lang.${code}`)} — ${t('lang.untranslated')}`}>
              {code.toUpperCase()}
            </abbr>
            {!has(code) && <span class="visually-hidden">{t('lang.untranslated')}</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: block;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius);
    color: var(--ink-faint);
    text-decoration: none;
    font-size: var(--step--1);
    letter-spacing: 0.03em;
  }

  a:hover {
    color: var(--ink);
    background: var(--bg-sunken);
  }

  /* Still a link, but not pretending to be a translation.
     The mark is texture, not weight. Dimming this with opacity took a 5.25:1
     grey down to 2.22:1 — the reader who most needs to notice the difference is
     the one least able to see it at that contrast. */
  a.untranslated abbr {
    text-decoration: underline dotted;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  a[aria-current='true'] {
    color: var(--ink);
    background: var(--bg-sunken);
    font-weight: 600;
  }

  abbr {
    text-decoration: none;
    border: 0;
  }
</style>

<script>
  // Argument anchors are locale-independent, so the fragment survives the jump.
  function carryAnchor() {
    const hash = window.location.hash;
    if (!hash) return;
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]')) {
      const url = new URL(link.href, window.location.origin);
      url.hash = hash;
      link.href = url.pathname + url.search + url.hash;
    }
  }

  carryAnchor();
  window.addEventListener('hashchange', carryAnchor);
</script>
