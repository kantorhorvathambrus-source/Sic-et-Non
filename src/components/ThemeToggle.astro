---
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false">
  <span class="visually-hidden">{t('theme.toggle')}</span>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="5.2" class="orb"></circle>
    <g class="rays" stroke-linecap="round">
      <path d="M12 1.6v2.6M12 19.8v2.6M22.4 12h-2.6M4.2 12H1.6"></path>
      <path d="M19.35 4.65l-1.84 1.84M6.49 17.51l-1.84 1.84M19.35 19.35l-1.84-1.84M6.49 6.49L4.65 4.65"></path>
    </g>
    <path class="crescent" d="M20 13.4A8.4 8.4 0 0 1 10.6 4a8.4 8.4 0 1 0 9.4 9.4z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
  }

  .crescent {
    display: none;
    fill: currentColor;
    stroke: none;
  }

  /* Show the sun in light mode and the moon in dark, in whichever way the
     theme was arrived at: system preference or the explicit toggle. */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .orb,
    :global(:root:not([data-theme='light'])) .rays {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .crescent {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .orb,
  :global(:root[data-theme='dark']) .rays {
    display: none;
  }

  :global(:root[data-theme='dark']) .crescent {
    display: block;
  }

  :global(:root[data-theme='light']) .orb,
  :global(:root[data-theme='light']) .rays {
    display: block;
  }

  :global(:root[data-theme='light']) .crescent {
    display: none;
  }
</style>

<script>
  const STORAGE_KEY = 'sen-theme';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');

  function systemPrefersDark(): boolean {
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function currentIsDark(): boolean {
    const explicit = root.dataset.theme;
    if (explicit === 'dark') return true;
    if (explicit === 'light') return false;
    return systemPrefersDark();
  }

  function sync() {
    button?.setAttribute('aria-pressed', String(currentIsDark()));
  }

  button?.addEventListener('click', () => {
    const next = currentIsDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // Private browsing, or site data blocked. The choice still applies to
      // this page view; it just will not be remembered.
    }
    sync();
  });

  // A system-level change only matters while the reader has made no choice.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!root.dataset.theme) sync();
    });

  sync();
</script>
