---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideColumn from '../SideColumn.astro';
import StatusTag from '../StatusTag.astro';
import ContextEntry from '../ContextEntry.astro';
import Distinctions from '../Distinctions.astro';
import TopicNote from '../TopicNote.astro';
import Quotation from '../Quotation.astro';
import DisclosureControls from '../DisclosureControls.astro';
import RichText from '../RichText.astro';
import { homePath, mapPath, useTranslations, type Locale } from '../../i18n';
import {
  alternatesForTopic,
  getTopicsForLocale,
  orderedSides,
  readingTime,
} from '../../lib/topics';
import { buildGlossary, toPlainText } from '../../lib/richtext';

interface Props {
  locale: Locale;
  topicId: string;
}

const { locale, topicId } = Astro.props;
const t = useTranslations(locale);

const entries = await getTopicsForLocale(locale);
const entry = entries.find((item) => item.data.id === topicId);
if (!entry) throw new Error(`No ${locale} content file for topic "${topicId}"`);

const topic = entry.data;
const glossary = buildGlossary(topic.glossary);
const sides = orderedSides(topic);
const alternates = await alternatesForTopic(topic.id);
const minutes = readingTime(topic);
---

<BaseLayout
  locale={locale}
  title={topic.title}
  description={toPlainText(topic.realQuestion).slice(0, 300)}
  alternates={alternates}
>
  <article class="topic">
    <div class="wrap">
      <header class="topic-head">
        <p class="eyebrow">
          <a href={homePath(locale)}>{t('topic.backToTopics')}</a>
          <span class="sep" aria-hidden="true">/</span>
          <span>{t('category.' + topic.category)}</span>
          <span class="sep" aria-hidden="true">/</span>
          <span>{t('topic.number', { n: topic.number })}</span>
        </p>

        <h1>{topic.title}</h1>

        <div class="head-meta">
          <StatusTag status={topic.status} locale={locale} />
          <span class="minutes">
            {t('topic.readingTime.layered', { summary: minutes.summary, full: minutes.full })}
          </span>
          <a class="map-link" href={mapPath(locale, topic.slug)}>{t('topic.argumentMap')}</a>
        </div>

        <p class="status-meaning">{t(`status.${topic.status}.meaning`)}</p>
      </header>

      <section class="panel real-question" aria-labelledby="real-question">
        <h2 id="real-question">{t('topic.realQuestion')}</h2>
        <RichText text={topic.realQuestion} glossary={glossary} />
      </section>

      {topic.distinctions && <Distinctions distinctions={topic.distinctions} locale={locale} />}

      {
        topic.settledCore && (
          <section class="panel settled" aria-labelledby="settled-core">
            <h2 id="settled-core">{t('topic.settledCore')}</h2>
            <RichText text={topic.settledCore} glossary={glossary} />
          </section>
        )
      }
    </div>

    <div class="wrap">
      <h2 class="sides-heading" id="sides">{t('topic.sides')}</h2>
      <DisclosureControls locale={locale} />
      <div class="sides">
        {
          sides.map((side) => (
            <SideColumn side={side} locale={locale} glossary={glossary} />
          ))
        }
      </div>
    </div>

    {
      topic.notes && (
        <div class="wrap">
          <section class="notes" aria-labelledby="notes-heading">
            <h2 id="notes-heading" class="minor-heading">
              {t('topic.notes')}
            </h2>
            <div class="note-list">
              {topic.notes.map((item) => (
                <TopicNote note={item} locale={locale} glossary={glossary} />
              ))}
            </div>
          </section>
        </div>
      )
    }

    {
      topic.context && (
        <div class="wrap">
          <section class="context" aria-labelledby="context-heading">
            <h2 id="context-heading" class="sides-heading">
              {topic.context.heading}
            </h2>

            {topic.context.intro && (
              <RichText
                text={topic.context.intro}
                glossary={glossary}
                class="context-intro"
              />
            )}

            {topic.context.note && (
              <aside class="context-note">
                <h3>{topic.context.note.heading}</h3>
                <RichText text={topic.context.note.text} glossary={glossary} />
                {topic.context.note.quote && (
                  <Quotation quote={topic.context.note.quote} locale={locale} side="neutral" />
                )}
              </aside>
            )}

            <ol class="position-list">
              {topic.context.entries.map((entry) => (
                <li>
                  <ContextEntry entry={entry} locale={locale} glossary={glossary} />
                </li>
              ))}
            </ol>
          </section>
        </div>
      )
    }

    <div class="wrap">
      <div class="closers">
        <section class="panel" aria-labelledby="where-it-stands">
          <h2 id="where-it-stands">{t('topic.whereItStands')}</h2>
          <RichText text={topic.whereItStands} glossary={glossary} />
        </section>

        <section class="panel" aria-labelledby="common-mistake">
          <h2 id="common-mistake">{t('topic.commonMistake')}</h2>
          <RichText text={topic.commonMistake} glossary={glossary} />
        </section>
      </div>

      {
        topic.glossary && topic.glossary.length > 0 && (
          <section class="glossary" aria-labelledby="glossary-heading">
            <h2 id="glossary-heading" class="minor-heading">
              {t('topic.glossary')}
            </h2>
            <dl>
              {topic.glossary.map((item) => (
                <div class="glossary-item">
                  <dt>{item.term}</dt>
                  <dd>{item.definition}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <section class="sources" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="minor-heading">{t('topic.sources')}</h2>
        <ul>
          {
            topic.sources.map((source) => (
              <li>
                <a href={source.url} rel="noopener noreferrer" target="_blank">
                  {source.title}
                </a>
                {source.author && <span class="src-author">{source.author}</span>}
                {source.year && <span class="src-year">{source.year}</span>}
                {source.note && <span class="src-note">{source.note}</span>}
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .topic-head {
    padding: var(--space-xl) 0 var(--space-l);
    max-width: var(--measure-wide);
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-m);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .eyebrow a {
    color: var(--ink-faint);
  }

  .sep {
    color: var(--rule-strong);
  }

  h1 {
    font-size: var(--step-4);
    margin-bottom: var(--space-m);
  }

  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    margin-bottom: var(--space-s);
  }

  .minutes {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .map-link {
    font-size: var(--step--1);
  }

  .status-meaning {
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  .panel {
    max-width: var(--measure-wide);
    margin-bottom: var(--space-l);
  }

  .panel h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .settled {
    padding: var(--space-m) var(--space-l);
    background: var(--bg-sunken);
    border-left: 3px solid var(--rule-strong);
    border-radius: var(--radius);
  }

  .sides-heading {
    font-size: var(--step-2);
    margin: var(--space-xl) 0 var(--space-m);
    padding-bottom: var(--space-xs);
    border-bottom: var(--hairline) solid var(--rule);
  }

  /*
    The two sides. Equal columns, one hairline between them, and no other
    difference in weight, size or spacing.
  */
  .sides {
    display: grid;
    grid-template-columns: 1fr var(--hairline) 1fr;
    gap: 0 var(--space-xl);
    align-items: start;
  }

  .sides::before {
    content: '';
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    width: var(--hairline);
    height: 100%;
    background: var(--rule);
  }

  .sides > :global(section:first-of-type) {
    grid-column: 1;
    grid-row: 1;
  }

  .sides > :global(section:last-of-type) {
    grid-column: 3;
    grid-row: 1;
  }

  .notes {
    margin-top: var(--space-xl);
  }

  .note-list {
    display: grid;
    gap: var(--space-m);
  }

  .context-note {
    max-width: var(--measure-wide);
    margin-bottom: var(--space-l);
    padding: var(--space-m) var(--space-l);
    background: var(--bg-sunken);
    border-left: 3px solid var(--rule-strong);
    border-radius: var(--radius);
  }

  .context-note h3 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .context-intro {
    max-width: var(--measure-wide);
    margin-bottom: var(--space-l);
    color: var(--ink-muted);
  }

  /* Two up on a wide screen, to sit under the two columns of arguments rather
     than trailing off narrowly beside them; one column once that would squeeze
     the one-line statements. */
  .position-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: var(--space-m) var(--space-xl);
    align-items: start;
  }

  .closers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: var(--hairline) solid var(--rule);
  }

  .closers .panel {
    margin-bottom: 0;
  }

  .minor-heading {
    font-size: var(--step-0);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-s);
  }

  .glossary,
  .sources {
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    border-top: var(--hairline) solid var(--rule);
    max-width: var(--measure-wide);
  }

  .glossary dl {
    margin: 0;
    display: grid;
    gap: var(--space-s);
  }

  .glossary-item {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1fr;
    gap: var(--space-m);
    font-size: var(--step--1);
  }

  .glossary dt {
    font-weight: 600;
    color: var(--ink);
  }

  .glossary dd {
    margin: 0;
    min-width: 0;
    color: var(--ink-muted);
  }

  .sources ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-s);
    font-size: var(--step--1);
  }

  .sources li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-xs);
    color: var(--ink-faint);
  }

  .src-note {
    flex-basis: 100%;
    color: var(--ink-faint);
  }

  @media (max-width: 52rem) {
    .sides {
      grid-template-columns: 1fr;
      gap: var(--space-xl) 0;
    }

    .sides::before {
      display: none;
    }

    .sides > :global(section:first-of-type),
    .sides > :global(section:last-of-type) {
      grid-column: 1;
      grid-row: auto;
    }

    .sides > :global(section:last-of-type) {
      padding-top: var(--space-xl);
      border-top: var(--hairline) solid var(--rule);
    }
  }

  @media (max-width: 34rem) {
    .glossary-item {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
