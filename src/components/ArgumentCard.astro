---
// One argument: the claim always visible, the substance behind a disclosure.
//
// This is a real <details>, not a scripted show/hide. The content stays in the
// DOM, so it is indexed by search, reachable by keyboard, findable with the
// browser's own find-in-page, and it prints.
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import type { GlossaryMap } from '../lib/richtext';
import RichText from './RichText.astro';
import Quotation from './Quotation.astro';

type Topic = CollectionEntry<'topics'>['data'];
type Argument = Topic['sides'][number]['arguments'][number];

interface Props {
  argument: Argument;
  position: 'theist' | 'atheist';
  locale: Locale;
  glossary: GlossaryMap;
}

const { argument, position, locale, glossary } = Astro.props;
const t = useTranslations(locale);

// Who raises the objection is declared in the content, not inferred from the
// layout. Unset means the other side, which is the ordinary case; an objection
// from within the same side, or pressed from both directions, is neither
// tinted with an opponent's hue nor labelled as coming from one.
const otherSide = position === 'theist' ? 'atheist' : 'theist';
const objectionFrom = argument.counter?.objectionFrom ?? otherSide;
const objectionTint = objectionFrom === 'both' || objectionFrom === 'within' ? 'neutral' : objectionFrom;
const objectionLabel =
  objectionFrom === 'within'
    ? t('argument.objection.within')
    : objectionFrom === 'both'
      ? t('argument.objection.both')
      : t('argument.objection.other');

// Which versions of this argument the objection actually reaches. An objection
// printed over three ways of holding a position, two of which it does not
// touch, is the failure variants exist to expose -- so the panel says so.
const variants = argument.variants ?? [];
const landsOn = argument.counter?.landsOn;
const reached = variants.filter((v) => landsOn?.includes(v.id));
const untouched = variants.filter((v) => !landsOn?.includes(v.id));
---

<details class:list={['argument', `side-${position}`]} id={argument.id} data-argument>
  <summary>
    <h3 class="claim">{argument.claim}</h3>
    <span class="visually-hidden">{t('argument.expand')}</span>
    <span class="marker" aria-hidden="true"></span>
  </summary>

  <div class="body">
    <RichText text={argument.explanation} glossary={glossary} class="explanation" />

    {argument.quote && <Quotation quote={argument.quote} locale={locale} side={position} />}

    {
      argument.counter && (
        <div class:list={['counter', `side-${objectionTint}`]}>
          <p class="counter-label">{objectionLabel}</p>
          <RichText text={argument.counter.objection} glossary={glossary} />

          {argument.counter.sharedPremise && (
            <p class="shared-premise">
              <strong>{t('argument.objection.sharedPremise')}</strong>{' '}
              {argument.counter.sharedPremise}
            </p>
          )}

          {argument.counter.quote && (
            <Quotation quote={argument.counter.quote} locale={locale} side={objectionTint} />
          )}

          {landsOn && variants.length > 0 && (
            <p class="lands-on">
              {reached.length === 0
                ? t('argument.landsOn.mainOnly')
                : `${t('argument.landsOn.reaches')} ${reached.map((v) => v.label).join(', ')}`}
              {untouched.length > 0 &&
                ` \u00b7 ${t('argument.landsOn.notReached')} ${untouched.map((v) => v.label).join(', ')}`}
            </p>
          )}

          {argument.counter.response && (
            <div class="response">
              <p class="counter-label">{t('argument.response')}</p>
              <RichText text={argument.counter.response} glossary={glossary} />
            </div>
          )}
        </div>
      )
    }

    {
      variants.length > 0 && (
        <div class="variants">
          <p class="variants-label">{t('argument.variants')}</p>
          {variants.map((variantValue) => (
            <details class="variant">
              <summary>
                <span class="variant-name">{variantValue.label}</span>
                <span class="variant-line">{variantValue.oneLine}</span>
                <span class="marker" aria-hidden="true" />
              </summary>
              <div class="variant-body">
                <p class="held-by">{variantValue.heldBy}</p>
                <RichText text={variantValue.summary} glossary={glossary} />
                <Quotation quote={variantValue.quote} locale={locale} side={position} />
                {variantValue.againstSettledCore && (
                  <p class="against-settled">
                    <strong>{t('argument.variants.againstSettledCore')}</strong>{' '}
                    {variantValue.againstSettledCore}
                  </p>
                )}
                <p class="changes">
                  <strong>{t('argument.variants.changes')}</strong> {variantValue.changesTheObjection}
                </p>

                {variantValue.objection && (
                  <div class="variant-objection">
                    <p class="counter-label">
                      {variantValue.objection.from === 'within'
                        ? t('argument.objection.within')
                        : variantValue.objection.from === 'both'
                          ? t('argument.objection.both')
                          : t('argument.objection.other')}
                    </p>
                    <RichText text={variantValue.objection.text} glossary={glossary} />
                    {variantValue.objection.sharedPremise && (
                      <p class="shared-premise">
                        <strong>{t('argument.objection.sharedPremise')}</strong>{' '}
                        {variantValue.objection.sharedPremise}
                      </p>
                    )}
                    {variantValue.objection.quote && (
                      <Quotation quote={variantValue.objection.quote} locale={locale} side="neutral" />
                    )}
                    {variantValue.objection.response && (
                      <div class="response">
                        <p class="counter-label">{t('argument.response')}</p>
                        <RichText text={variantValue.objection.response} glossary={glossary} />
                      </div>
                    )}
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      )
    }
  </div>
</details>

<style>
  .argument {
    padding-block: var(--space-m);
  }

  .argument + .argument {
    border-top: var(--hairline) solid var(--rule);
  }

  summary {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .claim {
    flex: 1;
    min-width: 0;
    font-size: var(--step-1);
    margin: 0;
  }

  .side-theist .claim {
    color: var(--theist);
  }

  .side-atheist .claim {
    color: var(--atheist);
  }

  summary:hover .claim {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  /* A chevron drawn in CSS, so there is no icon font or SVG to load. */
  .marker {
    flex: none;
    width: 0.6em;
    height: 0.6em;
    margin-top: 0.4em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 140ms ease;
    opacity: 0.55;
  }

  .side-theist .marker {
    color: var(--theist);
  }

  .side-atheist .marker {
    color: var(--atheist);
  }

  .argument[open] .marker {
    transform: rotate(-135deg);
    margin-top: 0.55em;
  }

  .body {
    padding-top: var(--space-s);
  }

  .argument:target > summary .claim {
    box-shadow: -0.55em 0 0 -0.4em currentColor;
  }

  .explanation {
    color: var(--ink);
  }

  .counter {
    margin-top: var(--space-m);
    padding: var(--space-m);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .counter.side-theist {
    background: var(--theist-soft);
  }

  .counter.side-atheist {
    background: var(--atheist-soft);
  }

  /* An objection from within, or from both directions, borrows neither hue. It
     keeps the same grammar as the tinted panels — a ground and a label in the
     matching colour — so that it reads as a third case rather than as one we
     forgot to colour. The label is what carries the meaning. */
  .counter.side-neutral {
    background: var(--bg-sunken);
  }

  .counter-label {
    margin: 0 0 var(--space-2xs);
    font-size: 0.82em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-muted);
  }

  .counter.side-theist .counter-label {
    color: var(--theist);
  }

  .counter.side-atheist .counter-label {
    color: var(--atheist);
  }

  .response {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: var(--hairline) solid color-mix(in oklab, currentColor 18%, transparent);
  }

  .response .counter-label {
    color: var(--ink-muted);
  }


  /* A side does not speak with one voice. Variants are always collapsed, so
     layer 1 never grows, and they sit under the objection because what they are
     for is showing which versions it reaches. */
  .variants {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: var(--hairline) solid var(--rule);
  }

  .variants-label,
  .lands-on {
    margin: 0 0 var(--space-xs);
    font-size: 0.82em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--ink-muted);
  }

  .lands-on {
    margin-top: var(--space-s);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 500;
    font-size: var(--step--1);
  }

  .variant {
    padding-block: var(--space-xs);
  }

  .variant + .variant {
    border-top: var(--hairline) solid var(--rule);
  }

  .variant > summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    flex-wrap: wrap;
    font-size: var(--step--1);
  }

  .variant-name {
    font-weight: 600;
  }

  .side-theist .variant-name {
    color: var(--theist);
  }

  .side-atheist .variant-name {
    color: var(--atheist);
  }

  .variant-line {
    flex: 1;
    min-width: 12rem;
    color: var(--ink-muted);
  }

  .variant .marker {
    width: 0.5em;
    height: 0.5em;
    margin-top: 0.15em;
  }

  .variant-body {
    padding: var(--space-s) 0 var(--space-s) var(--space-m);
    font-size: var(--step--1);
  }

  .held-by {
    margin: 0 0 var(--space-xs);
    color: var(--ink-faint);
    font-style: italic;
  }

  /* "Within" is a claim about premises, not about anybody's beliefs, so the
     panel shows the premise rather than leaving the label to be read as a
     statement about who is objecting. */
  .shared-premise {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* A variant the parent objection misses still has to face something. */
  .variant-objection {
    margin-top: var(--space-s);
    padding: var(--space-m);
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }

  .changes,
  .against-settled {
    margin-top: var(--space-s);
    padding: var(--space-s);
    border-left: 2px solid var(--rule-strong);
  }

  .changes strong,
  .against-settled strong {
    color: var(--ink);
  }

  /* Everything is open on paper; a collapsed argument would just be missing. */
  @media print {
    .argument .body,
    .variant .variant-body {
      display: block !important;
    }

    .marker {
      display: none;
    }
  }
</style>
