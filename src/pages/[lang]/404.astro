---
// One 404 per prefixed language, so /es/nonsense answers in Spanish.
import NotFoundPage from '../../components/pages/NotFoundPage.astro';
import { locales, defaultLocale, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
---

<NotFoundPage locale={locale} />
