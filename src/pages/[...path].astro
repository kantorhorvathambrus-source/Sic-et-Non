---
// Every route on the site.
//
// The path segments are localised — /topics/... in English, /es/temas/... in
// Spanish — which file-based routing cannot express, so the route table is
// generated (in lib/routes, shared with the sitemap) and each page kind is
// delegated to its own component.
import { siteRoutes } from '../lib/routes';
import HomePage from '../components/pages/HomePage.astro';
import AboutPage from '../components/pages/AboutPage.astro';
import TopicPage from '../components/pages/TopicPage.astro';
import ArgumentMapPage from '../components/pages/ArgumentMapPage.astro';
import SearchPage from '../components/pages/SearchPage.astro';

export async function getStaticPaths() {
  const routes = await siteRoutes();
  return routes.map(({ path, kind, locale, topicId }) => ({
    params: { path },
    props: { kind, locale, topicId },
  }));
}

const { kind, locale, topicId } = Astro.props;
---

{kind === 'home' && <HomePage locale={locale} />}
{kind === 'about' && <AboutPage locale={locale} />}
{kind === 'search' && <SearchPage locale={locale} />}
{kind === 'topic' && topicId && <TopicPage locale={locale} topicId={topicId} />}
{kind === 'map' && topicId && <ArgumentMapPage locale={locale} topicId={topicId} />}
