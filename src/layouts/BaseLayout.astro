---
import '../styles/global.css';
import {
  aboutPath,
  homePath,
  htmlLang,
  searchPath,
  locales,
  useTranslations,
  type Locale,
} from '../i18n';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  // Where the switcher sends the reader for each locale. A locale with no
  // translation of this page falls back to its home page, so no link is dead.
  alternates: Record<Locale, string>;
  // The locales that genuinely carry this page, for hreflang. Defaults to
  // alternates, which is correct for pages that exist in every language.
  translated?: Partial<Record<Locale, string>>;
  // Error pages are reachable but should not be indexed or canonicalised.
  noindex?: boolean;
  // Whether this page's own text belongs in the search index. The search page
  // and the 404s are navigation, not content: a reader searching for "suffering"
  // should not be handed the search box back.
  searchable?: boolean;
}

const {
  locale,
  title,
  description,
  alternates,
  translated = alternates,
  noindex = false,
  searchable = true,
} = Astro.props;
const hreflangs = locales.filter((code) => translated[code]);
const t = useTranslations(locale);
const site = Astro.site;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site ?? Astro.url);
// Open Graph wants language_TERRITORY, where <html lang> carries only the
// language. Nothing else on the page needs the territory, so it lives here.
const ogLocale: Record<Locale, string> = {
  en: 'en_GB',
  es: 'es_ES',
  fr: 'fr_FR',
  de: 'de_DE',
  hu: 'hu_HU',
};
const pageTitle = title === t('site.name') ? title : `${title} — ${t('site.name')}`;
---

<!doctype html>
<html lang={htmlLang[locale]} data-topic-root>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical.href} />}

    {
      hreflangs.map((code) => (
        <link
          rel="alternate"
          hreflang={htmlLang[code]}
          href={new URL(translated[code]!, site ?? Astro.url).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(translated.en ?? alternates.en, site ?? Astro.url).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      locales
        .filter((code) => code !== locale)
        .map((code) => <meta property="og:locale:alternate" content={ogLocale[code]} />)
    }
    <meta property="og:image" content={new URL('/og.png', site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.description')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', site ?? Astro.url).href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <script is:inline>
      // Applied before first paint so the page never flashes the wrong theme.
      try {
        var stored = localStorage.getItem('sen-theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {
        /* site data blocked; fall back to the system preference */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>

    <header class="masthead" data-pagefind-ignore>
      <div class="wrap masthead-inner">
        <a class="wordmark" href={homePath(locale)}>
          <span class="wordmark-name">{t('site.name')}</span>
        </a>

        <nav class="primary" aria-label={t('nav.home')}>
          <a href={homePath(locale)}>{t('nav.home')}</a>
          <a href={aboutPath(locale)}>{t('nav.about')}</a>
          <a href={searchPath(locale)}>{t('search.nav')}</a>
        </nav>

        <div class="controls">
          <LanguageSwitcher locale={locale} alternates={alternates} translated={translated} />
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </header>

    <main id="main" tabindex="-1" data-pagefind-body={searchable ? true : undefined} data-pagefind-ignore={searchable ? undefined : true}>
      <slot />
    </main>

    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <p class="tagline">{t('site.tagline')}</p>
        <p class="small">{t('footer.builtWith')}</p>
        <p class="small">{t('footer.license')}</p>
      </div>
    </footer>

    <script>
      // Touch devices have no hover, so a tap opens the definition instead.
      for (const term of document.querySelectorAll<HTMLElement>('dfn')) {
        term.addEventListener('click', (event) => {
          if (!window.matchMedia('(hover: none)').matches) return;
          event.preventDefault();
          const open = term.dataset.open === 'true';
          for (const other of document.querySelectorAll<HTMLElement>('dfn[data-open]')) {
            delete other.dataset.open;
          }
          if (!open) term.dataset.open = 'true';
        });
      }

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const open of document.querySelectorAll<HTMLElement>('dfn[data-open]')) {
          delete open.dataset.open;
        }
      });
    </script>
  </body>
</html>

<style>
  /* Fully opaque: at 88% the page text ghosted through the bar as it scrolled
     under, which reads as a rendering fault rather than as translucency. */
  .masthead {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--bg);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 3.5rem;
    flex-wrap: wrap;
  }

  .wordmark {
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    --measure-text: 26em;
    font-size: var(--step-1);
    letter-spacing: 0.01em;
    margin-right: auto;
  }

  .wordmark-name {
    font-style: italic;
  }

  .primary {
    display: flex;
    gap: var(--space-m);
  }

  .primary a {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: var(--step--1);
  }

  .primary a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  main:focus {
    outline: none;
  }

  .site-footer {
    margin-top: var(--space-2xl);
    padding: var(--space-l) 0 var(--space-xl);
    border-top: var(--hairline) solid var(--rule);
    color: var(--ink-faint);
  }

  .site-footer .tagline {
    font-family: var(--font-display);
    --measure-text: 26em;
    font-size: var(--step-0);
    color: var(--ink-muted);
    /* No max-width here. It used to be --measure-prose, a container width, which
       beat the global cap on specificity and let this one line — the only
       Garamond prose in the footer — run to 97 characters in Spanish and
       French. The global rule, in em and per face, is what should apply. */
  }

  .site-footer .small {
    font-size: var(--step--1);
    margin-bottom: var(--space-2xs);
  }

  @media (max-width: 32rem) {
    /* The bar needs two rows at this width. Sticking it would cost a fifth of a
       phone screen for the whole read, so it scrolls away instead. */
    .masthead {
      position: static;
    }

    .masthead-inner {
      padding-block: var(--space-xs);
    }

    .wordmark {
      font-size: var(--step-0);
    }
  }
</style>
