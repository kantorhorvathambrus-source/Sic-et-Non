# Cloudflare Pages reads this file and applies the rules to matching responses.
# It is not a redirect table; every path here already exists in dist/.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # The site loads nothing from anywhere else, so it can say so. Fonts, the
  # search index, the search runtime and its wasm are all on this origin.
  # 'unsafe-inline' covers Astro's scoped <style> blocks and the one inline
  # script that sets the theme before first paint; there is no third-party
  # script to allow and no connect-src beyond self.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# Hashed build output is immutable; everything else is small and revalidates.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/pagefind/*
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800
